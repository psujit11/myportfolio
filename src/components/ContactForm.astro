---
import profile from '../data/profile.json';
const prompt = `${profile.short_name.toLowerCase()}=#`;
---
<form class="insert" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-contact>
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="subject" value="Portfolio message" />
  <p hidden><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <p><span class="dim">{prompt}</span> <span class="kw">INSERT INTO</span> messages (name, email, message)</p>
  <p><span class="kw">VALUES</span> (</p>
  <label class="val"><span class="col">name</span><input name="name" required maxlength="80" autocomplete="name" placeholder="'Your name'" /></label>
  <label class="val"><span class="col">email</span><input name="email" type="email" required maxlength="120" autocomplete="email" placeholder="'you@example.com'" /></label>
  <label class="val"><span class="col">message</span><textarea name="message" required rows="4" maxlength="4000" placeholder="'Hi Sujit, ...'"></textarea></label>
  <p>);</p>

  <div class="run">
    <button class="btn">Run INSERT</button>
    <p class="out" data-out aria-live="polite"></p>
  </div>
</form>

<script>
  import { sendMessage } from '../send';

  document.querySelectorAll<HTMLFormElement>('[data-contact]').forEach((form) => {
    const out = form.querySelector<HTMLElement>('[data-out]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('bot-field')) return;
      const btn = form.querySelector('button')!;
      btn.disabled = true;
      out.className = 'out';
      out.textContent = 'Running…';
      try {
        await sendMessage({
          name: String(data.get('name')),
          email: String(data.get('email')),
          subject: String(data.get('subject')),
          message: String(data.get('message')),
        });
        out.className = 'out ok';
        out.textContent = `INSERT 0 1. Message sent. I'll reply to ${data.get('email')} soon.`;
        form.reset();
      } catch (err) {
        out.className = 'out err';
        out.textContent = `ERROR: message not sent (${(err as Error).message}). Use the email button below instead.`;
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .insert { background: var(--term); border: 1px solid var(--term-edge); border-radius: var(--r-lg); color: var(--term-text); padding: 22px; font: 0.92rem/1.7 var(--mono); display: grid; gap: 4px; }
  .dim { color: var(--term-dim); }
  .kw { color: #8fb0ff; }
  .val { display: grid; grid-template-columns: 90px 1fr; gap: 12px; align-items: start; padding-left: 24px; }
  .col { color: var(--term-dim); padding-top: 6px; }
  .val input, .val textarea { width: 100%; background: transparent; border: 0; border-bottom: 1px dashed #3a4f78; color: #7fe0b5; font: inherit; padding: 6px 2px; resize: vertical; }
  .val input::placeholder, .val textarea::placeholder { color: #4f6a8f; }
  .val input:focus-visible, .val textarea:focus-visible { outline: none; border-bottom: 1px solid #8fb0ff; background: #0f1b31; }
  .run { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 14px; }
  .out { font-size: 0.85rem; }
  .out:global(.ok) { color: #7fe0b5; }
  .out:global(.err) { color: #ff9fae; }
  @media (max-width: 600px) {
    .val { grid-template-columns: 1fr; gap: 0; padding-left: 12px; }
    .col { padding-top: 0; }
  }
</style>
