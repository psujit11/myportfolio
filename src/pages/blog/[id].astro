---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDay, getPosts } from '../../lib';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="wrap narrow">
    <header class="page-head">
      <a class="ident back" href="/blog">cd ../blog</a>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="meta">
        <span class="ident muted">{fmtDay(post.data.date)}</span>
        <div class="chips">{post.data.tags.map((t) => <span class="chip grey">#{t}</span>)}</div>
      </div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .narrow { max-width: 760px; }
  .back { text-decoration: none; }
  .back:hover { text-decoration: underline; }
  .meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 18px; }
  .prose { font-size: 1.07rem; line-height: 1.75; }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(pre), .prose :global(blockquote) { margin: 0 0 1.3em; }
  .prose :global(h2) { font-size: 1.6rem; margin: 2em 0 0.6em; }
  .prose :global(h3) { margin: 1.6em 0 0.5em; }
  .prose :global(:not(pre) > code) { font-size: 0.88em; background: var(--blue-soft); color: var(--blue); padding: 2px 6px; border-radius: var(--r-sm); }
  .prose :global(pre) { padding: 18px 20px; border-radius: var(--r); font-size: 0.88rem; line-height: 1.65; overflow-x: auto; }
  .prose :global(blockquote) { border-left: 3px solid var(--blue); padding-left: 16px; color: var(--slate); }
  .prose :global(img) { border-radius: var(--r); }
</style>
