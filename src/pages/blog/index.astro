---
import Base from '../../layouts/Base.astro';
import { fmtDay, getPosts } from '../../lib';

const posts = await getPosts();
---
<Base title="Blog" description="Tech notes by Sujit Sharma Poudel on .NET, SQL and building software.">
  <div class="wrap narrow">
    <header class="page-head">
      <span class="ident">SELECT * FROM blog ORDER BY published DESC;</span>
      <h1>Blog</h1>
      <p class="lede">Notes on .NET, SQL, architecture, and whatever I'm learning this month.</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty">No posts yet. The first one is in the oven.</p>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a class="card post" href={`/blog/${p.id}`}>
              <span class="ident muted">{fmtDay(p.data.date)}{p.data.draft && ' (draft)'}</span>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <div class="chips">{p.data.tags.map((t) => <span class="chip grey">#{t}</span>)}</div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .narrow { max-width: 820px; }
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .post { display: grid; gap: 10px; text-decoration: none; color: inherit; }
  .post:hover { border-color: var(--blue); }
  .post h2 { font-size: 1.4rem; }
  .post p { color: var(--slate); }
  .empty { color: var(--slate); }
</style>
