---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
import { getProjects, getSideQuests } from '../lib';
import { Code } from 'astro:components';

const [projects, sideQuests] = await Promise.all([getProjects(), getSideQuests()]);
// One group per language; the first entry's status speaks for the language.
const groups = [...Map.groupBy(sideQuests, (q) => q.data.language)].map(([language, items]) => ({ language, status: items[0].data.status, items }));
---
<Base title="Projects" description="Projects by Sujit Sharma Poudel: .NET APIs, a multi-tenant SaaS, web apps and side quests in other languages.">
  <div class="wrap">
    <header class="page-head">
      <span class="ident">SELECT * FROM projects;</span>
      <h1>Projects</h1>
      <p class="lede">Things I've built: a multi-tenant SaaS, .NET APIs and web apps, a PHP system and an ML experiment from university.</p>
    </header>

    <div class="bento">
      {projects.map((p) => (
        <article class:list={['card', 'proj', { featured: p.data.featured && p.data.snippet }]}>
          <div class="proj-body">
            <div class="proj-head">
              <h2>{p.data.title}</h2>
              <div class="chips">{p.data.tags.map((t) => <span class="chip">{t}</span>)}</div>
            </div>
            <p class="summary">{p.data.summary}</p>
            {(p.data.repo || p.data.live || p.data.private) && (
              <div class="link-row proj-links">
                {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener"><Icon name="code" size={16} /> source</a>}
                {p.data.private && <span class="private"><Icon name="code" size={16} /> private repo</span>}
                {p.data.live && <a href={p.data.live} target="_blank" rel="noopener"><Icon name="arrow" size={16} /> live</a>}
              </div>
            )}
          </div>
          {p.data.featured && p.data.snippet && (
            <div class="snippet"><Code code={p.data.snippet.trimEnd()} lang={p.data.snippet_lang as any} theme="github-dark-dimmed" /></div>
          )}
        </article>
      ))}
      <a class="card more" href={profile.github} target="_blank" rel="noopener">
        <Icon name="github" size={28} />
        <h2>More on GitHub</h2>
        <p>Experiments, practice repos and work in progress.</p>
      </a>
    </div>

    {groups.length > 0 && (
      <section class="section quests" id="side-quests">
        <div class="section-title"><h2>Side quests</h2></div>
        <p class="quests-intro">I write C# for a living. That doesn't mean I can't write anything else. It means I chose to. Here's the proof, plus small experiments that never grew into full projects. (PHP? It's complicated. See Online Marriage Registration above.)</p>
        {groups.map((g) => (
          <article class="quest-group">
            <header>
              <h3>{g.language}</h3>
              <p class="ident muted">relationship_status</p>
              <p class="status">{g.status}</p>
            </header>
            <ul>
              {g.items.map((q) => (
                <li>
                  {q.data.repo ? <a href={q.data.repo} target="_blank" rel="noopener">{q.data.title}</a> : <span class="q-title">{q.data.title}</span>}
                  <p>{q.data.summary}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    )}
  </div>
</Base>

<style>
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 960px) { .bento { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .bento { grid-template-columns: 1fr; } }

  .proj { display: flex; flex-direction: column; padding: 0; overflow: hidden; }
  .proj-body { padding: 26px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .proj-head { display: grid; gap: 10px; }
  .proj h2 { font-size: 1.4rem; }
  .summary { color: var(--slate); font-size: 0.95rem; }
  .proj-links { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); }

  .featured { grid-column: span 3; flex-direction: row; background: var(--term); border-color: var(--term-edge); color: #fff; }
  .featured .summary { color: var(--term-text); }
  .featured .chip { background: #16264a; color: #a9c1ff; }
  .featured .proj-links { border-color: var(--term-line); }
  .featured .proj-links a { color: #8fb0ff; }
  .featured .proj-body { flex: 1 1 45%; }
  .snippet { flex: 1 1 55%; padding: 26px; background: #121e33; display: flex; align-items: center; min-width: 0; }
  .snippet :global(pre) { margin: 0; padding: 20px; border-radius: var(--r); font-size: 0.82rem; line-height: 1.7; overflow-x: auto; width: 100%; border: 1px solid var(--term-line); }
  @media (max-width: 960px) { .featured { grid-column: span 2; } }
  @media (max-width: 760px) { .featured { flex-direction: column; grid-column: auto; } }

  .more { display: grid; align-content: center; gap: 8px; text-decoration: none; color: var(--ink); border-style: dashed; background: transparent; }
  .more:hover { border-color: var(--blue); color: var(--blue); }
  .private { display: inline-flex; gap: 6px; align-items: center; color: var(--slate); }
  .featured .private { color: var(--term-dim); }
  .quests { scroll-margin-top: 80px; }
  .quests-intro { color: var(--slate); max-width: 68ch; margin: -8px 0 12px; }
  .quest-group { display: grid; grid-template-columns: 240px 1fr; gap: 28px; padding: 26px 0; border-top: 1px solid var(--line); }
  .quest-group:first-of-type { border-top: 0; }
  .quest-group h3 { font: 600 1.15rem/1.3 var(--mono); }
  .quest-group header .ident { margin-top: 10px; }
  .status { font-style: italic; color: var(--love); margin-top: 2px; }
  .quest-group ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px 28px; }
  .quest-group li a, .q-title { font-weight: 600; text-decoration: none; color: var(--ink); }
  .quest-group li a:hover { color: var(--blue); text-decoration: underline; }
  .quest-group li p { color: var(--slate); font-size: 0.93rem; margin-top: 4px; }
  @media (max-width: 700px) { .quest-group { grid-template-columns: 1fr; gap: 14px; } }
  .more h2 { font-size: 1.4rem; }
  .more p { color: var(--slate); }
</style>
